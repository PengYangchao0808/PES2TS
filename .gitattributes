# Binary / evidence files: never text-normalize archive snapshots.
*.pt binary
*.ckpt binary
*.png binary
*.jpg binary
*.xlsx binary
*.parquet binary
*.h5 binary
*.hdf5 binary
*.npz binary
docs/archive/** -text

# Frozen split/reaction ID lists: keep the bytes verbatim on every platform so
# the sha256 values in data/manifests/split_registry_v1.json keep verifying
# after a clone (a CRLF-converting checkout would otherwise change them).
data/manifests/*ids* -text
