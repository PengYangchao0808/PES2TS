# PES2TS ripgrep ignore file (ADR-0036 five-zone layout).
# Keep searches on the ACTIVE surface: pes2ts_core (minus the frozen V4/V5.x
# model files below), pes2ts_data, pes2ts_v5, infra, docs,
# tests/{kernel,data,v5}, config/experiments.

# Zone 5: frozen historical campaigns (read-only; never imported by active code)
archive/

# Legacy test tier: historical V4 / V5.1-V5.4 tests (auto-marked `legacy`)
tests/legacy/

# Frozen V4/V5.x model files inside Zone 1
pes2ts_core/pesn/models/v54*
pes2ts_core/pesn/**/*dual_ts*

# Local data / run outputs / scratch
data/
outputs/
.slim/
.omo/
.venv/

# Caches
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.pyc
*.pyo
